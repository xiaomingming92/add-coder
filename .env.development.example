# 复制为 .env.development
# compose 和 Prisma 共用这一个文件

# 数据库凭据
DATABASE_USER=<DATABASE_USER>
DATABASE_PASSWORD=<DATABASE_PASSWORD>
DATABASE_PORT=<DATABASE_PORT>
PROJECT_NAME=<PROJECT_NAME>
DATA_DIR=<DATA_DIR>
# Prisma 连接串
DATABASE_URL="postgresql://<DATABASE_USER>:<DATABASE_PASSWORD>@localhost:<DATABASE_PORT>/<PROJECT_NAME>?schema=public"

# 影子库（migrate dev 必需，指向 compose 中 shadow-postgres 服务端口 5434）
SHADOW_DATABASE_USER=<DATABASE_USER>
SHADOW_DB_PASSWORD=<SHADOW_DB_PASSWORD>
SHADOW_DB_NAME=<SHADOW_DB_NAME>
SHADOW_DB_PORT=<SHADOW_DB_PORT>
SHADOW_DATA_DIR=<SHADOW_DATA_DIR>
# Prisma 连接串
SHADOW_DATABASE_URL="postgresql://<DATABASE_USER>:<DATABASE_PASSWORD>@localhost:<SHADOW_DB_PORT>/<PROJECT_NAME>-shadow?schema=public"
