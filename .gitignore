node_modules
dist
/src/generated/prisma
podman-compose.yml
podman-compose.add.yml
docker-compose.yml
docker-compose.add.yml
.env.development
.env
.prisma
.backup/*
# 例外：bash hooks 退役收拢是溯源资产（历史实现 + 溯源 README），随仓库保存
!.backup/20260814_bash-hooks-retire/

# IDE runtime configs with credentials
.claude/mcp.json
.qoder/mcp.json
.vscode/mcp.json
.vscode/settings.json

# Runtime artifacts
debug-dump/
*/debug-dump/
# MCP 运行态"需重启"标记：由 server 启动时自愈清除（2026-09-14），属瞬态产物，不跟踪
*/.mcp-restart-required
# Local workflow artifacts（plans/specs/reviews/hitl 为本地运行产物，不同步远端）
*/plans/
*/specs/
*/reviews/
*/hitl/

# Runtime reports
*/reports/

# 记忆运行态产物（l1/l2 快照由 memory-jobs 随跑随刷新、fts-fingerprint 随重建写入、
# evidence-queue* 为 append-only 队列进度 —— 全是机器本地状态，不入库）
*/memory/

# HITL sentinel files (runtime artifacts)
.hitl-tongyi-*
.hitl-bohui-*
scripts/crontab*
# Database sync backups (prisma-sync v2)
.add/backups/

# 哨兵文件忽略（.tongyi-*/.bohui-* 与既有 .hitl-tongyi-* 规则前缀不匹配的兜底）
*/hitl/.tongyi-*
*/hitl/.bohui-*
# 工作流产物未跟踪兜底（main 已跟踪的历史文件不受影响；新产物不入库）
.qoder/plans/
.qoder/specs/
.qoder/reviews/
