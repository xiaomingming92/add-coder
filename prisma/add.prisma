// add.prisma — ADD 治理模型，独立于用户业务表

model AddUser {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String?
  devOperations DevOperation[]
  auditLogs     AuditLog[]
}

model DevOperation {
  id          String   @id @default(cuid())
  userId      String
  user        AddUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKeyword String
  action      String
  targetType  String
  targetId    String
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([planKeyword])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        AddUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  traceId     String?
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([traceId])
}

// ===== HITL 人机审核架构 =====

enum HitlType {
  PLAN
  PLAN_REVIEW
  COLLAB_CONTRACT
}

enum HitlStatus {
  DRAFT
  SUBMITTED
  TONGYI
  BOHUI
}

enum ReviewType {
  PLAN_REVIEW
  IMPLEMENTATION
  RUNTIME
}

model HitlRecord {
  id           String     @id @default(cuid())
  planName     String
  plan         PlanRecord @relation(fields: [planName], references: [planName])
  round        Int        @default(1)
  type         HitlType   @default(PLAN)
  status       HitlStatus @default(DRAFT)
  proposalPath String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectReason String?
  createdBy    String     @default("ai-assistant")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([planName, round])
  @@index([planName])
  @@index([status])
}

model PlanRecord {
  id              String         @id @default(cuid())
  planName        String         @unique
  planPath        String
  specPath        String?
  tasksPath       String?
  checklistPath   String?
  addRoutePath    String?
  totalTasks      Int            @default(0)
  doneTasks       Int            @default(0)
  checklistT      Int            @default(0)
  checklistTDone  Int            @default(0)
  checklistR      Int            @default(0)
  planKeyword     String?
  // 并发协作契约：该 Plan 在契约中的角色（MASTER=总控 / SUB=子 Plan）
  contractRole    ContractRole?
  // 所属契约名（与 CollabContract.contractName 对应，反查用）
  contractName    String?
  // 作为总控 Plan 持有的契约（masterPlanName 外键方向）
  masterContract  CollabContract?
  // DPS 四维评分历史（check_dps 调用后回写，供 FFT 自适应权重消费）
  dpsSemScore     Int? // 语义相关性 0-100
  dpsEntropyScore Int? // 信息熵匹配 0-100
  dpsCpmScore     Int? // CPM 关键路径 0-100
  dpsStructScore  Int? // 结构完整度 0-100
  dpsComposite    Int? // 加权 DPS 总分 0-100
  hitls           HitlRecord[]
  reviews         ReviewRecord[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([planKeyword])
  @@index([contractName])
}

model ReviewRecord {
  id           String     @id @default(cuid())
  planName     String
  plan         PlanRecord @relation(fields: [planName], references: [planName], onDelete: Cascade)
  type         ReviewType @default(PLAN_REVIEW)
  reviewPath   String?
  p0Count      Int        @default(0)
  p1Count      Int        @default(0)
  backflowRate Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([planName])
  @@index([type])
}

enum ContractRole {
  MASTER  // 总控 Plan（契约持有者）
  SUB     // 子 Plan（契约实施单元）
}

// 并发协作契约（多智能体并行实施规则集，对应 collab-contract 文档）
model CollabContract {
  id                 String   @id @default(cuid())
  contractName       String   @unique
  contractPath       String
  // 外键：总控 Plan（契约持有者，ContractRole=MASTER，一对一）
  masterPlanName     String   @unique
  masterPlan         PlanRecord @relation(fields: [masterPlanName], references: [planName], onDelete: Restrict)
  participants       Json     // [{role, platformEntity, boundPlan, planKeyword, description}]
  abilityMatrix      Json?    // {能力: {专家: boolean}}
  stages             Json     // [{stage, expert, trigger, parallelism}]
  dependencyGraph    String?  // ASCII 图 + 机器可读声明
  fileBoundaries     Json     // [{expert, exclusiveDomain, forbidden, isolationMode}]  isolationMode: file/worktree
  completionCriteria Json?    // {专家: 完成标志}
  status             String   @default("ACTIVE") // ACTIVE / SUPERSEDED
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([masterPlanName])
}
