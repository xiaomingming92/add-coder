// add.prisma — ADD 治理模型，独立于用户业务表

model AddUser {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String?
  devOperations DevOperation[]
  auditLogs     AuditLog[]
}

model DevOperation {
  id          String   @id @default(cuid())
  userId      String
  user        AddUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKeyword String
  action      String
  targetType  String
  targetId    String
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([planKeyword])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        AddUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  targetType  String
  targetId    String
  traceId     String?
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([traceId])
}

// ===== HITL 人机审核架构 =====

enum HitlType {
  PLAN
  PLAN_REVIEW
}

enum HitlStatus {
  DRAFT
  SUBMITTED
  TONGYI
  BOHUI
}

enum ReviewType {
  PLAN_REVIEW
  IMPLEMENTATION
  RUNTIME
}

model HitlRecord {
  id           String     @id @default(cuid())
  planName     String
  plan         PlanRecord @relation(fields: [planName], references: [planName])
  round        Int        @default(1)
  type         HitlType   @default(PLAN)
  status       HitlStatus @default(DRAFT)
  proposalPath String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectReason String?
  createdBy    String     @default("ai-assistant")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([planName, round])
  @@index([planName])
  @@index([status])
}

model PlanRecord {
  id              String         @id @default(cuid())
  planName        String         @unique
  planPath        String
  specPath        String?
  tasksPath       String?
  checklistPath   String?
  addRoutePath    String?
  totalTasks      Int            @default(0)
  doneTasks       Int            @default(0)
  checklistT      Int            @default(0)
  checklistTDone  Int            @default(0)
  checklistR      Int            @default(0)
  planKeyword     String?
  // DPS 四维评分历史（check_dps 调用后回写，供 FFT 自适应权重消费）
  dpsSemScore     Int? // 语义相关性 0-100
  dpsEntropyScore Int? // 信息熵匹配 0-100
  dpsCpmScore     Int? // CPM 关键路径 0-100
  dpsStructScore  Int? // 结构完整度 0-100
  dpsComposite    Int? // 加权 DPS 总分 0-100
  hitls           HitlRecord[]
  reviews         ReviewRecord[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([planKeyword])
}

model ReviewRecord {
  id           String     @id @default(cuid())
  planName     String
  plan         PlanRecord @relation(fields: [planName], references: [planName], onDelete: Cascade)
  type         ReviewType @default(PLAN_REVIEW)
  reviewPath   String?
  p0Count      Int        @default(0)
  p1Count      Int        @default(0)
  backflowRate Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([planName])
  @@index([type])
}
