// add.prisma — ADD 治理模型，独立于用户业务表

model AddUser {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String?
  devOperations DevOperation[]
  auditLogs     AuditLog[]
}

model DevOperation {
  id                 String   @id @default(cuid())
  userId             String
  user               AddUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectKey         String   @default("legacy-unknown")
  producerAdapterKey String   @default("legacy-unknown")
  contextId          String   @default("legacy-unknown")
  toolName           String   @default("record_dev_operation")
  operationKey       String   @default(cuid())
  planKeyword        String
  action             String
  targetType         String
  targetId           String
  beforeState        Json?
  afterState         Json?
  reason             String?
  createdAt          DateTime @default(now())

  @@unique([projectKey, producerAdapterKey, toolName, operationKey])
  @@index([planKeyword])
  @@index([projectKey, producerAdapterKey, planKeyword])
}

model AuditLog {
  id                 String   @id @default(cuid())
  userId             String
  user               AddUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectKey         String   @default("legacy-unknown")
  producerAdapterKey String   @default("legacy-unknown")
  contextId          String   @default("legacy-unknown")
  action             String
  targetType         String
  targetId           String
  traceId            String?
  beforeState        Json?
  afterState         Json?
  reason             String?
  createdAt          DateTime @default(now())

  @@index([traceId])
  @@index([projectKey, producerAdapterKey, contextId])
}

// ===== HITL 人机审核架构 =====

enum HitlType {
  PLAN
  PLAN_REVIEW
  COLLAB_CONTRACT
}

enum HitlStatus {
  DRAFT
  SUBMITTED
  TONGYI
  BOHUI
}

enum ReviewType {
  PLAN_REVIEW
  IMPLEMENTATION
  RUNTIME
}

enum PlanLifecycleStatus {
  DRAFT
  ACTIVE
  BLOCKED
  REJECTED
  CLOSED
  REOPENED
  ABANDONED
}

model HitlRecord {
  id           String     @id @default(cuid())
  projectKey   String     @default("legacy-unknown")
  adapterKey   String     @default("legacy-unknown")
  planName     String
  plan         PlanRecord @relation(fields: [projectKey, adapterKey, planName], references: [projectKey, adapterKey, planName], onDelete: Cascade)
  round        Int        @default(1)
  type         HitlType   @default(PLAN)
  status       HitlStatus @default(DRAFT)
  proposalPath String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectReason String?
  createdBy    String     @default("ai-assistant")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([projectKey, adapterKey, planName, type, round])
  @@index([projectKey, adapterKey, planName])
  @@index([status])
}

model PlanRecord {
  id               String                     @id @default(cuid())
  projectKey       String                     @default("legacy-unknown")
  adapterKey       String                     @default("legacy-unknown")
  planName         String
  lifecycle        PlanLifecycleStatus        @default(DRAFT)
  revision         Int                        @default(0)
  planPath         String
  specPath         String?
  tasksPath        String?
  checklistPath    String?
  addRoutePath     String?
  totalTasks       Int                        @default(0)
  doneTasks        Int                        @default(0)
  checklistT       Int                        @default(0)
  checklistTDone   Int                        @default(0)
  checklistR       Int                        @default(0)
  planKeyword      String?
  // 并发协作契约：该 Plan 在契约中的角色（MASTER=总控 / SUB=子 Plan）
  contractRole     ContractRole?
  // 所属契约名（与 CollabContract.contractName 对应，反查用）
  contractName     String?
  // 作为总控 Plan 持有的契约（masterPlanName 外键方向）
  masterContract   CollabContract?            @relation("MasterPlan")
  contractBindings CollaborationPlanBinding[]
  // DPS 四维评分历史（check_dps 调用后回写，供 FFT 自适应权重消费）
  dpsSemScore      Int? // 语义相关性 0-100
  dpsEntropyScore  Int? // 信息熵匹配 0-100
  dpsCpmScore      Int? // CPM 关键路径 0-100
  dpsStructScore   Int? // 结构完整度 0-100
  dpsComposite     Int? // 加权 DPS 总分 0-100
  hitls            HitlRecord[]
  reviews          ReviewRecord[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([projectKey, adapterKey, planName])
  @@index([planKeyword])
  @@index([contractName])
  @@index([projectKey, adapterKey, lifecycle])
}

model ReviewRecord {
  id           String     @id @default(cuid())
  projectKey   String     @default("legacy-unknown")
  adapterKey   String     @default("legacy-unknown")
  planName     String
  plan         PlanRecord @relation(fields: [projectKey, adapterKey, planName], references: [projectKey, adapterKey, planName], onDelete: Cascade)
  type         ReviewType @default(PLAN_REVIEW)
  reviewPath   String?
  p0Count      Int        @default(0)
  p1Count      Int        @default(0)
  backflowRate Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([projectKey, adapterKey, planName])
  @@index([type])
}

enum ContractRole {
  MASTER // 总控 Plan（契约持有者）
  SUB // 子 Plan（契约实施单元）
}

enum CollaborationBindingRole {
  MASTER
  MEMBER
}

// 并发协作契约（多智能体并行实施规则集，对应 collab-contract 文档）
model CollabContract {
  id                 String                     @id @default(cuid())
  projectKey         String                     @default("legacy-unknown")
  ownerAdapterKey    String                     @default("legacy-unknown")
  contractName       String
  contractPath       String
  // 外键：总控 Plan（契约持有者，ContractRole=MASTER，一对一）
  masterProjectKey   String                     @default("legacy-unknown")
  masterAdapterKey   String                     @default("legacy-unknown")
  masterPlanName     String
  masterPlan         PlanRecord                 @relation("MasterPlan", fields: [masterProjectKey, masterAdapterKey, masterPlanName], references: [projectKey, adapterKey, planName], onDelete: Restrict)
  bindings           CollaborationPlanBinding[]
  participants       Json // [{role, platformEntity, boundPlan, planKeyword, description}]
  abilityMatrix      Json? // {能力: {专家: boolean}}
  stages             Json // [{stage, expert, trigger, parallelism}]
  dependencyGraph    String? // ASCII 图 + 机器可读声明
  fileBoundaries     Json // [{expert, exclusiveDomain, forbidden, isolationMode}]  isolationMode: file/worktree
  completionCriteria Json? // {专家: 完成标志}
  status             String                     @default("ACTIVE") // ACTIVE / SUPERSEDED
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@unique([projectKey, contractName])
  @@unique([masterProjectKey, masterAdapterKey, masterPlanName])
  @@index([projectKey, ownerAdapterKey])
}

model CollaborationPlanBinding {
  id         String                   @id @default(cuid())
  contractId String
  contract   CollabContract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  projectKey String
  adapterKey String
  planName   String
  plan       PlanRecord               @relation(fields: [projectKey, adapterKey, planName], references: [projectKey, adapterKey, planName], onDelete: Cascade)
  role       CollaborationBindingRole @default(MEMBER)
  createdAt  DateTime                 @default(now())

  @@unique([contractId, projectKey, adapterKey, planName])
  @@index([projectKey, adapterKey, planName])
}

// ===== Agent Memory 知识治理层（Plan: add-coder-agent-memory-plan-v2） =====
// 数据约束（Plan §4.4）：
// - ACTIVE 必须至少关联一条 Evidence；approve 时 approvedBy/approvedAt 必填
// - SUPERSEDED 必须设置 supersededById，且新旧 repository/scope 兼容
// - validUntil <= now() 不得进入默认召回；HYPOTHESIS 不得作为 Gate 强约束
// - importance/confidence ∈ [0,1]；contentHash = sha256(规范化文本)，幂等含 repository+scope
// - ORGANIZATION scope 首版禁用（枚举保留，写入拒绝，§17-7 定案）

enum MemoryKind {
  DECISION
  CONSTRAINT
  PITFALL
  FAILURE
  LESSON
  PATTERN
  CONVENTION
  FACT
  HANDOFF_DIGEST
  HYPOTHESIS
}

enum MemoryStatus {
  CANDIDATE
  PENDING
  ACTIVE
  STALE
  SUPERSEDED
  REJECTED
  ARCHIVED
}

enum MemoryScopeType {
  ORGANIZATION
  REPOSITORY
  BRANCH
  MODULE
  PATH
  SYMBOL
  PLAN
  SPEC
}

enum MemorySourceType {
  PLAN
  SPEC
  DPS_GATE
  DEV_OPERATION
  RAHS_GATE
  HANDOFF
  MANUAL
  IMPORT
}

enum EmbeddingState {
  DISABLED
  PENDING
  READY
  FAILED
  STALE
}

enum RecallOutcome {
  UNKNOWN
  USED
  USEFUL
  IRRELEVANT
  OUTDATED
  CONTRADICTED
  HARMFUL
}

model AddMemory {
  id              String          @id @default(cuid())
  kind            MemoryKind
  status          MemoryStatus    @default(CANDIDATE)
  topic           String
  content         String
  summary         String?

  scopeType       MemoryScopeType
  scopeValue      String
  repositoryRef   String

  importance      Float           @default(0.5)
  confidence      Float           @default(0.5)
  validFrom       DateTime        @default(now())
  validUntil      DateTime?

  supersededById  String?
  supersededBy    AddMemory?      @relation("MemorySupersession", fields: [supersededById], references: [id])
  supersedes      AddMemory[]     @relation("MemorySupersession")

  contentHash     String
  embeddingModel  String?
  embeddingDim    Int?
  embeddingState  EmbeddingState  @default(DISABLED)

  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  evidenceLinks   AddMemoryEvidenceLink[]
  recalls         AddMemoryRecallItem[]

  @@index([repositoryRef, status, kind])
  @@index([scopeType, scopeValue])
  @@index([supersededById])
  @@index([status, validUntil])
  @@unique([repositoryRef, contentHash, scopeType, scopeValue])
}

model AddMemoryEvidence {
  id            String           @id @default(cuid())
  repositoryRef String
  sourceType    MemorySourceType
  sourceRef     String
  planKeyword   String?
  excerpt       String
  contentHash   String
  occurredAt    DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())

  memoryLinks   AddMemoryEvidenceLink[]

  @@index([repositoryRef, sourceType, sourceRef])
  @@index([planKeyword])
  @@unique([repositoryRef, sourceType, sourceRef, contentHash])
}

model AddMemoryEvidenceLink {
  memoryId    String
  evidenceId  String
  relation    String?
  createdAt   DateTime          @default(now())

  memory      AddMemory         @relation(fields: [memoryId], references: [id])
  evidence    AddMemoryEvidence @relation(fields: [evidenceId], references: [id])

  @@id([memoryId, evidenceId])
}

// sourceRef 约定：必须包含当次运行标识（格式 {gate}:{planKeyword}:{runId}），
// 同一 Gate 对同一来源的重复测量由 runId 区分（Review P1 #2 回流）
model AddMetricSnapshot {
  id            String   @id @default(cuid())
  repositoryRef String
  metricType    String
  value         Float
  baseline      Float?
  delta         Float?
  unit          String?
  planKeyword   String?
  specRef       String?
  commitSha     String?
  sourceRef     String
  metadata      Json?
  measuredAt    DateTime @default(now())

  @@index([repositoryRef, metricType, measuredAt])
  @@unique([repositoryRef, metricType, sourceRef])
}

model AddMemoryRecall {
  id               String          @id @default(cuid())
  repositoryRef    String
  query            String
  stage            String
  consumerRef      String?
  scopeContext     Json
  candidateIds     Json
  selectedIds      Json
  scoreBreakdown   Json
  exclusionReasons Json?
  rankingVersion   String
  tokenBudget      Int
  injectedTokens   Int
  latencyMs        Int?
  degradedMode     String?
  createdAt        DateTime        @default(now())
  items            AddMemoryRecallItem[]

  @@index([repositoryRef, stage, createdAt])
}

model AddMemoryRecallItem {
  recallId   String
  memoryId   String
  selected   Boolean
  rank       Int?
  outcome    RecallOutcome @default(UNKNOWN)
  feedback   String?
  updatedAt  DateTime      @updatedAt

  recall     AddMemoryRecall @relation(fields: [recallId], references: [id])
  memory     AddMemory       @relation(fields: [memoryId], references: [id])

  @@id([recallId, memoryId])
}
